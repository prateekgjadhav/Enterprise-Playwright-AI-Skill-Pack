{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "useDefineForClassFields": true,
    "types": [
      "node"
    ],
    "paths": {
      "@fixtures": [
        "src/fixtures/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "scripts/lib/*.d.mts"
  ]
}
